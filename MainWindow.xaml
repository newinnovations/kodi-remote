<Window x:Class="KodiListenerGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodi IR Controller &amp; Monitor" Height="800" Width="1400"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section 1: Kodi Live Status Indicators -->
        <GroupBox Header="Kodi Status" Grid.Row="0" Foreground="#00FFCC" BorderBrush="#555" Margin="0,0,0,15" Padding="10" FontSize="16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Zoom Factor:" Foreground="#AAA" FontSize="20"/>
                    <TextBlock x:Name="TxtZoom" Text="1.0x" FontSize="40" FontWeight="Bold" Foreground="#FFFF00"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Active Subtitle:" Foreground="#AAA" FontSize="20"/>
                    <TextBlock x:Name="TxtActiveSubtitle" Text="None / Disabled" FontSize="40" FontWeight="Bold" Foreground="#00FFCC"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Section 2: Subtitle Track Listing -->
        <TextBlock Grid.Row="1" Text="Available Subtitle Tracks:" Foreground="#AAA" Margin="0,0,0,5"/>
        <ListBox x:Name="LstSubtitles" Grid.Row="1" Background="#2D2D2D" Foreground="#FFF" BorderBrush="#555" Margin="0,0,0,15" FontSize="16"/>

        <!-- Section 3: Debug Logging -->
        <TextBlock Grid.Row="2" Text="Debug Log:" Foreground="#AAA" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtLog" Grid.Row="3" Background="#111" Foreground="#00FF00" FontSize="14"
                 FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" BorderBrush="#555"/>
    </Grid>
</Window>
