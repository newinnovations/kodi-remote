<Window x:Class="KodiRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodi IR Controller &amp; Monitor" Height="800" Width="1400"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition x:Name="RowDebugLabel" Height="0"/>
            <RowDefinition x:Name="RowDebugLog" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Section 1: Kodi Live Status Indicators. Tap to toggle window/fullscreen mode for touch devices without a keyboard. -->
        <GroupBox x:Name="StatusBox" Header="Kodi Status (tap to toggle window/fullscreen)" Grid.Row="0" Foreground="#00FFCC" BorderBrush="#555" Margin="0,0,0,15" Padding="10" FontSize="16"
                  Cursor="Hand" Background="#1E1E1E" MouseLeftButtonUp="StatusBox_MouseLeftButtonUp">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/> <!-- This expands to push the last item right -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Zoom Factor (Left) -->
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="Zoom Factor" Foreground="#AAA" FontSize="16"/>
                        <TextBlock x:Name="TxtZoom" Text="1.0x" FontSize="40" FontWeight="Bold" Foreground="#FFFF00"/>
                    </StackPanel>

                    <!-- Active Subtitle (Middle-Left) -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Active Subtitle" Foreground="#AAA" FontSize="16"/>
                        <TextBlock x:Name="TxtActiveSubtitle" Text="None" FontSize="40" FontWeight="Bold" Foreground="#00FFCC"/>
                    </StackPanel>

                    <!-- Ends at (Far Right) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Ends at" Foreground="#AAA" FontSize="16" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtEndsAt" Text="" FontSize="40" FontWeight="Bold" Foreground="#00FFCC"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,30,0">
                        <TextBlock Text="Now Playing" Foreground="#AAA" FontSize="16"/>
                        <TextBlock x:Name="TxtNowPlaying" Text="Nothing playing" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Status" Foreground="#AAA" FontSize="16" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtPlaybackStatus" Text="" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Assigned to Column 0 (Takes up remaining space) -->
                    <!-- Added Right Margin to prevent the bar from touching the text -->
                    <ProgressBar x:Name="PbPosition" Grid.Column="0" Height="16" Minimum="0" Maximum="1" Value="0" Margin="0,4,15,0"
                                Foreground="#00FFCC" Background="#2D2D2D" BorderBrush="#555"/>

                    <!-- Assigned to Column 1 (Sized to fit its content on the right) -->
                    <TextBlock x:Name="TxtPosition" Grid.Column="1" Text="0:00 / 0:00" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Section 2: Subtitle Track Listing -->
        <TextBlock Grid.Row="1" Text="Available Subtitle Tracks" Foreground="#AAA" Margin="0,0,0,5"/>
        <Border Grid.Row="1" Background="#2D2D2D" BorderBrush="#555" BorderThickness="1" Margin="0,20,0,15">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LstSubtitles" Foreground="#FFF" FontSize="30" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Margin="0,0,50,6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CCC"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="#00FFCC"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Section 3: Debug Logging. Hidden while fullscreen; shown in windowed mode. -->
        <TextBlock x:Name="LblDebugLog" Grid.Row="2" Text="Debug Log" Foreground="#AAA" Margin="0,0,0,5" Visibility="Collapsed"/>
        <TextBox x:Name="TxtLog" Grid.Row="3" Background="#111" Foreground="#00FF00" FontSize="14"
                 FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" BorderBrush="#555" Visibility="Collapsed"/>
    </Grid>
</Window>
